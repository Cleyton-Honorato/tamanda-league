# ── Banco de dados ────────────────────────────────────────────────────────
# Local (Docker):  mongodb://localhost:27017/tamanda-league
# Produção (Atlas): mongodb+srv://USUARIO:SENHA@cluster.xxxx.mongodb.net/tamanda-league?retryWrites=true&w=majority
MONGODB_URI=

# ── Sessão do admin ───────────────────────────────────────────────────────
# Gere um valor novo para cada ambiente: openssl rand -base64 32
JWT_SECRET=

# ── Admin inicial (usado só por: npm run seed:admin) ──────────────────────
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── Cloudinary (fotos e vídeos da galeria) ────────────────────────────────
# O API_SECRET só é usado no servidor e nunca chega ao navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────
APP_TZ=America/Sao_Paulo
# Endereço público, usado na prévia do link ao compartilhar (ex.: WhatsApp).
# Em produção: https://seu-site.vercel.app
NEXT_PUBLIC_SITE_URL=
